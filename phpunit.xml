<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>mysql-aislado</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:JAJcx+HsrY8ojD6fBpYdYYOAAaCIuewCLUrwCl23ISc=" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <!-- Base http fija: con el APP_URL https del .env de producción las peticiones de prueba
             llegaban como seguras y cambiaban las cabeceras (HSTS). -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="ADMIN_DEFAULT_PASSWORD" value="Admin123*" force="true"/>
        <env name="TECNICO_DEFAULT_PASSWORD" value="Tecni123*" force="true"/>
        <env name="INVITADO_DEFAULT_PASSWORD" value="Invit123*" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="GOOGLE_DRIVE_BACKUP_PATH" value=""/>
        <!-- Sin clave de respaldos por defecto: las pruebas de cifrado la fijan ellas mismas.
             Si se hereda del .env, los respaldos de prueba salen cifrados (.zip). -->
        <env name="BACKUP_PASSWORD" value="" force="true"/>
    </php>
</phpunit>
